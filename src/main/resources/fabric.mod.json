{
  "schemaVersion": 1,
  "id": "soft_hardcore",
  "version": "${version}",
  "name": "Soft Hardcore",
  "description": "Cada muerte rompe un corazon de forma permanente. Agota tus vidas y el mundo queda en estado Hardcore.",
  "authors": ["juanestban"],
  "contact": {
    "sources": "https://github.com/juanestban/soft-hardcore-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/modid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.softhardcore.SoftHardcore"],
    "client": ["com.softhardcore.client.SoftHardcoreClient"]
  },
  "mixins": [
    "soft_hardcore.mixins.json",
    {
      "config": "softhardcore.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "fabric-api": "*"
  }
}
